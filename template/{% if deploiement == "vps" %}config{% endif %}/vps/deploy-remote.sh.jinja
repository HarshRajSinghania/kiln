#!/usr/bin/env bash
# Bascule de l'API sur le serveur, en root. Appelée par scripts/ops/deploy-backend.sh.
#
# Installée à chaque déploiement en /usr/local/sbin/{{ nom }}-deploy-remote : c'est la seule
# commande que l'utilisateur `deploy` peut lancer par sudo (config/vps/setup-deploy-user.sh).
#
#   {{ nom }}-deploy-remote base <branche>       commit de la branche connu du serveur
#   {{ nom }}-deploy-remote deploy clé=valeur…   bascule (arguments : scripts/ops/deploy-backend.sh)
#   {{ nom }}-deploy-remote rollback             retour à la version précédente
#
# Chaque image est gardée sous le SHA de son commit (les KEEP_IMAGES dernières) ; DEPLOYED donne
# celle en service. Le retour arrière part de là, jamais de :latest, et il est automatique quand la
# nouvelle version ne répond pas. Les migrations ne se défont pas : après une migration de schéma,
# revenir en arrière, c'est restaurer la sauvegarde d'avant bascule ([DEPLOIEMENT-REVERSIBLE]).
set -euo pipefail

NAME={{ nom }}
DB_USER={{ nom | replace('-', '_') }}
API_DOMAIN={{ domaine_api }}
{% raw -%}
ROOT="/opt/$NAME"
IMAGE="localhost/${DB_USER}_backend"
BUILD="/opt/$NAME-build"
KEEP_IMAGES=5
REPO_ENV="$ROOT/.env"
BACKEND_ENV="$ROOT/backend/.env"
LOG_DIR="/var/log/$NAME-deploy"
ENV_FILE="$(mktemp)"
LOG=/dev/null
trap 'rm -f "$ENV_FILE"' EXIT
cd "$ROOT"

die() { echo "ÉCHEC : $*" >&2; exit 1; }
tag_of() { echo "$IMAGE:${1:0:12}"; }

# Sorties de podman-compose gardées dans le journal du déploiement, montrées en cas d'échec.
compose() {
  if ! podman-compose -f compose.yaml "$@" >> "$LOG" 2>&1; then
    tail -20 "$LOG" >&2
    die "podman-compose $* (journal : $LOG)"
  fi
}

# Environnement d'une commande lancée hors de la pile (migrations, contrôles) : celui du backend,
# plus l'adresse de la base, lus dans les fichiers du serveur.
write_env_file() {
  [ -f "$BACKEND_ENV" ] || die "$BACKEND_ENV absent : le créer d'après backend/.env.example."
  grep -q '^POSTGRES_PASSWORD=.' "$REPO_ENV" 2> /dev/null || die "POSTGRES_PASSWORD absent de $REPO_ENV."
  grep -vE '^\s*(#|$)' "$BACKEND_ENV" > "$ENV_FILE"
  printf 'DATABASE_URL=postgres://%s:%s@127.0.0.1:5432/%s\n' \
    "$DB_USER" "$(grep '^POSTGRES_PASSWORD=' "$REPO_ENV" | cut -d= -f2-)" "$DB_USER" >> "$ENV_FILE"
}

run_image() {  # run_image <image> <commande…>
  local image="$1"
  shift
  podman run --rm --network host --env-file "$ENV_FILE" "$image" "$@"
}

# Sonde locale, sans Caddy ni TLS : l'hôte et le schéma attendus par Django sont posés à la main.
wait_for_version() {
  local health
  for _ in $(seq 1 40); do
    health="$(curl -fsS --max-time 5 -H "Host: $API_DOMAIN" -H 'X-Forwarded-Proto: https' \
      http://127.0.0.1:8000/api/health 2> /dev/null || true)"
    grep -q "$1" <<< "$health" && return 0
    sleep 3
  done
  return 1
}

wait_for_db() {
  for _ in $(seq 1 30); do
    podman exec "$NAME-db" pg_isready -h 127.0.0.1 -U "$DB_USER" > /dev/null 2>&1 && return 0
    sleep 2
  done
  die "la base ne répond pas."
}

# Migrations appliquées par l'image donnée. Sans migration en attente, le backend en service n'est
# pas arrêté : l'API ne se tait que pendant une vraie migration.
migrate_with() {
  if run_image "$1" python manage.py migrate --check >> "$LOG" 2>&1; then
    echo "Aucune migration en attente : base inchangée."
    return
  fi
  compose stop backend
  run_image "$1" python manage.py migrate --no-input >> "$LOG"
  echo "Base migrée par ${1##*:} : données conservées."
}

switch_to() {  # switch_to <sha>
  podman tag "$(tag_of "$1")" "$IMAGE:latest"
  compose up -d --no-deps --force-recreate backend
  wait_for_version "$1"
}

rollback_to() {  # rollback_to <sha>
  podman image exists "$(tag_of "$1")" || die "image $(tag_of "$1") absente : retour arrière impossible."
  [ -f compose.yaml.previous ] && install -m 600 compose.yaml.previous compose.yaml
  switch_to "$1" || die "la version ${1:0:12} ne répond pas non plus (podman logs $NAME-backend)."
  echo "$1" > DEPLOYED
}

fail_and_roll_back() {
  echo "ÉCHEC : $1" >&2
  podman logs --tail 30 "$NAME-backend" >&2 || true
  [ -n "${PREV:-}" ] || die "aucune version précédente connue ; sauvegarde d'avant bascule : ${BACKUP:-aucune}."
  echo "Retour arrière automatique vers ${PREV:0:12}…" >&2
  rollback_to "$PREV"
  echo "Retour arrière effectué : ${PREV:0:12} en service. Sauvegarde d'avant bascule : ${BACKUP:-aucune}." >&2
  exit 1
}

wait_for_healthy_containers() {
  local deadline=$((SECONDS + 300)) pending name status
  while :; do
    pending=""
    for name in $(podman ps --filter "name=^$NAME-" --format '{{.Names}}'); do
      status="$(podman inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$name")"
      [ -z "$status" ] || [ "$status" = healthy ] || pending+=" $name($status)"
    done
    [ -z "$pending" ] && break
    [ "$SECONDS" -ge "$deadline" ] && die "conteneurs pas « healthy » après 5 min :$pending."
    sleep 10
  done
  echo "Conteneurs munis d'une sonde : tous « healthy »."
}

# Images par SHA au-delà des KEEP_IMAGES plus récentes, sauf la version en service et la précédente.
prune_images() {
  local kept=0 tag
  while read -r tag; do
    [[ "$tag" =~ ^[0-9a-f]{12}$ ]] || continue
    kept=$((kept + 1))
    if [ "$kept" -gt "$KEEP_IMAGES" ] && [ "$tag" != "${TARGET:0:12}" ] && [ "$tag" != "${PREV:0:12}" ]; then
      podman rmi "$IMAGE:$tag" > /dev/null 2>&1 || true
    fi
  done < <(podman images "$IMAGE" --format '{{.CreatedAt}}|{{.Tag}}' | sort -r | cut -d'|' -f2)
  podman image prune -f > /dev/null 2>&1 || true
}

# Scripts, unités systemd et Caddyfile de la version reçue, installés sur le serveur.
install_server_files() {
  local script
  for script in backup restore-test heal; do
    install -m 700 "$BUILD/config/vps/$script.sh" "/usr/local/sbin/$NAME-$script"
  done
  install -m 700 "$BUILD/config/vps/deploy-remote.sh" "/usr/local/sbin/$NAME-deploy-remote"
  install -m 644 "$BUILD"/config/vps/*.service "$BUILD"/config/vps/*.timer /etc/systemd/system/
  systemctl daemon-reload
  systemctl enable --now "$NAME-backup.timer" "$NAME-restore-test.timer" "$NAME-heal.timer" > /dev/null 2>&1
  # Relance des conteneurs `restart: always` après un redémarrage du serveur.
  systemctl enable podman-restart.service > /dev/null 2>&1 || true
  if ! cmp -s "$BUILD/config/vps/Caddyfile" /etc/caddy/Caddyfile; then
    [ -f /etc/caddy/Caddyfile ] && install -m 644 /etc/caddy/Caddyfile /etc/caddy/Caddyfile.previous
    install -m 644 "$BUILD/config/vps/Caddyfile" /etc/caddy/Caddyfile
    systemctl reload caddy
    echo "Caddyfile installé et rechargé (précédent : /etc/caddy/Caddyfile.previous)."
  fi
}

# Code reçu, image construite et vérifiée, configuration validée : rien n'est encore basculé.
build_candidate() {
  if [ "${arg[send]}" = 1 ]; then
    git bundle verify -q "$INCOMING/code.bundle"
    git fetch -q "$INCOMING/code.bundle" "+$BRANCH:refs/remotes/origin/$BRANCH"
  fi
  [ "$(git rev-parse "refs/remotes/origin/$BRANCH")" = "$TARGET" ] || die "le serveur n'a pas reçu $TARGET."
  rm -rf "$BUILD" && mkdir -p "$BUILD"
  git archive "$TARGET" backend config/vps | tar -x -C "$BUILD"
  echo "$TARGET" > "$BUILD/backend/GIT_SHA"
  podman build --pull=newer --network=host -q -f "$BUILD/backend/Containerfile" -t "$TAG" "$BUILD" >> "$LOG"
  [ "$(podman run --rm --entrypoint cat "$TAG" GIT_SHA)" = "$TARGET" ] || die "l'image $TAG ne porte pas la version $TARGET."
  echo "Image $TAG prête."
  podman-compose -f "$BUILD/config/vps/compose.yaml" config > /dev/null 2>> "$LOG" || die "pile compose invalide."
  install -d -o caddy -g caddy -m 750 /var/log/caddy
  caddy validate --adapter caddyfile --config "$BUILD/config/vps/Caddyfile" >> "$LOG" 2>&1 || die "Caddyfile invalide."
  local script
  for script in "$BUILD"/config/vps/*.sh; do bash -n "$script"; done
  write_env_file
  run_image "$TAG" python manage.py check --deploy --fail-level ERROR
  echo "Pile compose, Caddyfile, scripts et réglages de production valides."
}

cmd_base() {
  git rev-parse -q --verify "refs/remotes/origin/${1:?branche attendue}" || true
}

cmd_rollback() {
  install -d -m 700 "$LOG_DIR"
  LOG="$LOG_DIR/$(date +%Y%m%d-%H%M%S)-rollback.log"
  [ -f DEPLOYED.previous ] || die "aucune version précédente connue ($ROOT/DEPLOYED.previous)."
  local previous current
  previous="$(cat DEPLOYED.previous)"
  current="$(cat DEPLOYED 2> /dev/null || true)"
  rollback_to "$previous"
  [ -n "$current" ] && echo "$current" > DEPLOYED.previous
  echo "$(date -Is) rollback $previous" >> deploy-history.log
  echo "Retour arrière effectué : ${previous:0:12} en service."
}

cmd_deploy() {
  declare -gA arg=([send]=0 [dry_run]=0)
  local pair key value
  for pair in "$@"; do
    key="${pair%%=*}"
    value="${pair#*=}"
    case "$key" in branch | target | send | dry_run | incoming) ;; *) die "argument inconnu : $key" ;; esac
    [[ "$value" =~ ^[A-Za-z0-9._/-]*$ ]] || die "valeur refusée pour $key"
    arg[$key]="$value"
  done
  BRANCH="${arg[branch]:?branch=}"
  TARGET="${arg[target]:?target=}"
  INCOMING="${arg[incoming]:?incoming=}"
  [[ "$TARGET" =~ ^[0-9a-f]{40}$ ]] || die "commit cible invalide : $TARGET"
  case "$INCOMING" in "/root/$NAME-incoming" | /home/deploy/incoming) ;; *) die "réception refusée : $INCOMING" ;; esac
  TAG="$(tag_of "$TARGET")"
  install -d -m 700 "$LOG_DIR"
  LOG="$LOG_DIR/$(date +%Y%m%d-%H%M%S)-${TARGET:0:12}.log"
  trap 'rm -f "$ENV_FILE" "$INCOMING/code.bundle"' EXIT

  build_candidate
  if [ "${arg[dry_run]}" = 1 ]; then
    echo "Essai à blanc terminé : rien n'a été basculé."
    return 0
  fi

  install_server_files
  wait_for_db
  "/usr/local/sbin/$NAME-backup" pre-deploy
  BACKUP="$(find /root/backups -maxdepth 1 -name "$NAME-pre-deploy-*.dump" -printf '%T@ %p\n' | sort -rn | head -1 | cut -d' ' -f2-)"
  PREV="$(cat DEPLOYED 2> /dev/null || true)"
  [ -f compose.yaml ] && install -m 600 compose.yaml compose.yaml.previous
  install -m 600 "$BUILD/config/vps/compose.yaml" compose.yaml
  compose up -d --no-deps db
  wait_for_db

  migrate_with "$TAG"
  switch_to "$TARGET" || fail_and_roll_back "le backend ${TARGET:0:12} ne répond pas sur /api/health."
  wait_for_healthy_containers
  echo "$TARGET" > DEPLOYED
  [ -n "$PREV" ] && [ "$PREV" != "$TARGET" ] && echo "$PREV" > DEPLOYED.previous
  echo "$(date -Is) deploy $TARGET" >> deploy-history.log
  prune_images

  # Sonde de bout en bout, à travers Caddy et TLS.
  local health=""
  for _ in $(seq 1 10); do
    health="$(curl -fsS --max-time 10 "https://$API_DOMAIN/api/health" 2> /dev/null || true)"
    grep -q "$TARGET" <<< "$health" && break
    sleep 3
  done
  grep -q "$TARGET" <<< "$health" \
    || die "l'API répond en local mais pas via https://$API_DOMAIN (Caddy, DNS, TLS ?) : ${health:-aucune réponse}."
  echo "Sonde https://$API_DOMAIN/api/health : version $TARGET en service."
}

case "${1:-}" in
  base) cmd_base "${2:-}" ;;
  deploy) shift && cmd_deploy "$@" ;;
  rollback) cmd_rollback ;;
  *) die "usage : $NAME-deploy-remote base <branche> | deploy clé=valeur… | rollback" ;;
esac
{%- endraw %}
